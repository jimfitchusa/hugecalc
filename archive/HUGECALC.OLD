/* This is the enhanced hugecalc program (c version) originally from
   PC Magazine 24 Sep 91. */

/* to do

make a list of enhancements ...

   accept negative numbers -- done


   accept floating point numbers -- +, -, *, /, ^ done
      need \ and ^ for decimal exponets (root)  make \ for rm and / for dec.

   convert to BCD (refer to magazine article)

   add other functions (sin, cos, tan, etc.)

*/

#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <io.h>

#define TRUE 1
#define FALSE 0
#define MAXSIZE 5000

/* Global variables */

char *op, *operand1 = "", *operand2= "", *result, *rem, operation;
int minus1 = FALSE, minus2 = FALSE;
long decimal1 = 0, decimal2 = 0, TOL;
char *helpmessage = \
"Enter 'HC ## op ##', where op is +,-,*,\\,or ^\n\
   or 'HC ## !' for factorial.\n\
   '\\' is for integer division and '/' is for decimal division.";

/* Function declarations */

   /* calc functions */

char addchar(char c1, char c2, int *carry);
char subchar(char c1, char c2, int *borrow);
void fillchar(char *s, char c, int n);
void leftpad0(char *s, int len);
void trimlead0(char *s);
int compare(char *x, char *y);
void add(char *a, char *b, char *ans);
void sub(char *a, char *b, char *ans);
void prod(char *a, char *b, char *ans);
void divide(char *a, char *b, char *rm, char *ans);
void fact(char *a, char *ans);
void power(char *b, char *e, char *ans);

   /* main functions */

int allnums(char *a);
int gotparams(int argc, char *argv[]);
int addcomma(char *s);
void rightpad0(char *s, int zeros);
int decimalcheck(void);
void adddecimal(char *s, long place);


main(int argc, char *argv[])
{
char *opswap, *m, *r2, *two = "2", *end, *inputfile = "hugecalc.cfg";
int i;
FILE *fpin;

if((op = malloc((MAXSIZE+3)*sizeof(char))) == NULL)
{
   printf("Not enough memory for op\n");
   exit(1);
}
if((operand1 = malloc((MAXSIZE+3)*sizeof(char))) == NULL)
{
   printf("Not enough memory for operand1\n");
   exit(1);
}
if((operand2 = malloc((MAXSIZE+3)*sizeof(char))) == NULL)
{
   printf("Not enough memory for operand2\n");
   exit(1);
}
if((result = malloc((MAXSIZE+3)*sizeof(char))) == NULL)
{
   printf("Not enough memory for result\n");
   exit(1);
}
if((rem = malloc((MAXSIZE+3)*sizeof(char))) == NULL)
{
   printf("Not enough memory for rem\n");
   exit(1);
}
if((r2 = malloc((MAXSIZE+3)*sizeof(char))) == NULL)
{
   printf("Not enough memory for r2\n");
   exit(1);
}
if((m = malloc((MAXSIZE+3)*sizeof(char))) == NULL)
{
   printf("Not enough memory for m\n");
   exit(1);
}
*m = '-';
*(m+1) = '\0';

if((fpin = fopen(inputfile, "rt")) == NULL)
{
   printf("Cannot open configuration file %s\n", inputfile);
   exit(0);
}

if(!fscanf(fpin, "TOL = E-%li", &TOL))
{
   printf("Error reading information in inputfile, %s\n", inputfile);
   printf("File must contain 'TOL = E-#', where # is any integer.\n");
   exit(0);
}

if(!gotparams(argc, argv)) exit(1);

if(!decimalcheck())
{
   printf(helpmessage);
   exit(1);
}

start:;

switch (operation)
{
   case '+':
   {
      if(!minus1 && minus2)
      {
	 minus2 = FALSE;
	 operation = '-';
	 goto start;
      }
      if(minus1 && !minus2)
      {
	 opswap = operand1; operand1 = operand2; operand2 = opswap;
	 minus1 = FALSE;
	 operation = '-';
	 goto start;
      }
      /* Adjust the size of operand1 and operand2 with rightpad0
	 so each has the same number of decimal places. */

      if(decimal1 > decimal2) rightpad0(operand2, decimal1-decimal2);
      if(decimal2 > decimal1) rightpad0(operand1, decimal2-decimal1);

      if(isatty(fileno(stdout)))
      {
	 printf("       SUM: ");
	 add(operand1, operand2, result);
	 if(decimal1 > decimal2) adddecimal(result, decimal1);
	 if(decimal2 > decimal1) adddecimal(result, decimal2);
	 if(decimal1>0 && decimal1==decimal2) adddecimal(result, decimal1);
	 addcomma(result);
      }
      else
      {
	 add(operand1, operand2, result);
	 if(decimal1 > decimal2) adddecimal(result, decimal1);
	 if(decimal2 > decimal1) adddecimal(result, decimal2);
	 if(decimal1>0 && decimal1==decimal2) adddecimal(result, decimal1);
      }
      if(minus1 && minus2)
      {
	 if(strlen(result) < MAXSIZE)
	 {
	    strcat(m, result);
	    strcpy(result, m);
	 }
	 else
	 {
	    printf("MAXSIZE too small for m in main.\n");
	    exit(1);
	 }
      }
      printf("%s\n", result); break;
   }
   case '-':
   {
      if(!minus1 && minus2)
      {
	 minus2 = FALSE;
	 operation = '+';
	 goto start;
      }
      if(minus1 && !minus2)
      {
	 minus2 = TRUE;
	 operation = '+';
	 goto start;
      }

      if(decimal1 > decimal2) rightpad0(operand2, decimal1-decimal2);
      if(decimal2 > decimal1) rightpad0(operand1, decimal2-decimal1);

      if(isatty(fileno(stdout)))
      {
	 printf("DIFFERENCE: ");
	 if(minus1 && minus2) sub(operand2, operand1, result);
	 else sub(operand1, operand2, result);
	 if(decimal1 > decimal2) adddecimal(result, decimal1);
	 if(decimal2 > decimal1) adddecimal(result, decimal2);
	 if(decimal1>0 && decimal1==decimal2) adddecimal(result, decimal1);
	 addcomma(result);
      }
      else
      {
	 if(minus1 && minus2) sub(operand2, operand1, result);
	 else sub(operand1, operand2,result);
	 if(decimal1 > decimal2) adddecimal(result, decimal1);
	 if(decimal2 > decimal1) adddecimal(result, decimal2);
	 if(decimal1>0 && decimal1==decimal2) adddecimal(result, decimal1);
      }
      printf("%s\n", result); break;
   }
   case '*':
   {
      if(isatty(fileno(stdout)))
      {
	 printf("   PRODUCT: ");
	 prod(operand1, operand2, result);
	 if(decimal1>0 || decimal2>0) adddecimal(result, decimal1+decimal2);
	 addcomma(result);
      }
      else
      {
	 prod(operand1, operand2, result);
	 if(decimal1>0 || decimal2>0) adddecimal(result, decimal1+decimal2);
      }
      if((!minus1 && minus2) || (minus1 && !minus2))
      {
	 if(strlen(result) < MAXSIZE)
	 {
	    strcat(m, result);
	    strcpy(result, m);
	 }
	 else
	 {
	    printf("MAXSIZE too small for m in main.\n");
	    exit(1);
	 }
      }
      printf("%s\n", result); break;
   }
   case '\\':
   {
      if(isatty(fileno(stdout)))
      {
	 printf("  QUOTIENT: ");
	 divide(operand1, operand2, rem, result);
	 if((!minus1 && minus2) || (minus1 && !minus2))
	 {
	    if(strlen(result) < MAXSIZE)
	    {
	       strcat(m, result);
	       strcpy(result, m);
	    }
	    else
	    {
	       printf("MAXSIZE too small for m in main.\n");
	       exit(1);
	    }
	 }
	 addcomma(result); printf("%s\n", result);
	 printf(" REMAINDER: ");
	 addcomma(rem); printf("%s\n", rem); break;
      }
      else
      {
	 divide(operand1, operand2, rem, result);
	 if((!minus1 && minus2) || (minus1 && !minus2))
	 {
	    if(strlen(result) < MAXSIZE)
	    {
	       strcat(m, result);
	       strcpy(result, m);
	    }
	    else
	    {
	       printf("MAXSIZE too small for m in main.\n");
	       exit(1);
	    }
	 }
	 printf("%s\n", result); break;
      }
   }
   case '!':
   {
      if(minus1)
      {
	 printf("Factorial is only valid for positive numbers.\n");
	 exit(1);
      }
      if(isatty(fileno(stdout)))
      {
	 printf(" FACTORIAL: ");
	 fact(operand1, result);
	 addcomma(result); printf("%s\n", result); break;
      }
      else
      {
	 fact(operand1, result);
	 printf("%s\n", result); break;
      }
   }
   case '^':
   {
      if(minus2)
      {
	 printf("Power is not setup for negative exponets.\n");
	 exit(1);
      }
      if(isatty(fileno(stdout)))
      {
	 printf("     POWER: ");
	 power(operand1, operand2, result);
	 if(decimal1 > 0)
	    adddecimal(result, decimal1*strtol(operand2, &end, 10));
	 addcomma(result);
      }
      else
      {
	 power(operand1, operand2, result);
	 if(decimal1 > 0)
	    adddecimal(result, decimal1*strtol(operand2, &end, 10));
      }
      if(minus1)
      {
	 divide(operand2, two, rem, r2);
	 if(*rem != '0')
	 {
	    if(strlen(result) < MAXSIZE)
	    {
	       strcat(m, result);
	       strcpy(result, m);
	    }
	    else
	    {
	       printf("MAXSIZE too small for m in main.\n");
	       exit(1);
	    }
	 }
      }
      printf("%s\n", result); break;
   }
}
return 0;
}

int allnums(char *a)
{
   char numbers[] = ".-0123456789";

   if(strspn(a,numbers) == strlen(a)) return 1;
   return 0;
}

int gotparams(int argc, char *argv[])

/* PURPOSE : Returns true if parameters are correctly passed on the
    command line -- and assigns them to the correct variables if so. */

{
   char *operators = "!^*-+\\/";
   int b, paramcount, redir1 = FALSE, redir2 = FALSE;

   b = 2;
   paramcount = argc - 1;

   if(!isatty(fileno(stdin)))    /* stdin has been redirected */
   {
      gets(op);
      if(*op == '-')
      {
	 minus1 = TRUE;
	 op++;
      }
      b--;

      /* now deterimine if op is just a number
	 or if it is a number operand number */

      if(strcspn(op, operators) == strlen(op))
      {
	 redir1 = TRUE;
	 redir2 = FALSE;
      }
   }
   if(!redir1 && !redir2)     /* no redirect at all */
   {
      if(paramcount < b)
      {
	 printf("%s",helpmessage);
	 return 0;
      }
      strcpy(operand1, argv[1]);
      operation = *argv[b];
      strcpy(operand2, argv[b+1]);
   }
   else if(redir1 && !redir2)    /* operand1 is redirected, */
   {                             /* rest is from command line */
      strcpy(operand1, op);
      operation = *argv[b];
      strcpy(operand2, argv[b+1]);
   }
   else   /* all input is redirected */
   {
      b = 2;        /* reset b */

      strcpy(operand1, strtok(op, " "));
      if(strlen(operand1) != 0)
      {
	 if((operation = *strtok(NULL, " ")) !=  NULL)
	 {
	    if(operation == '!')
	    {
	       paramcount = 2;
	    }
	    else
	    {
	       paramcount = 3;
	       if((strcpy(operand2, strtok(NULL, "\n"))) == NULL)
	       {
		  printf("%s",helpmessage);
		  return 0;
	       }
	    }
	 }
	 else
	 {
	    printf("%s",helpmessage);
	    return 0;
	 }
      }
      else
      {
	 printf("%s",helpmessage);
	 return 0;
      }
   }
   if(!allnums(operand1))
   {
      printf("'%s' is not a positive integer.\n",operand1);
      exit(1);
   }
   if(*operand1 == '-')
   {
      minus1 = TRUE;
      operand1++;
   }
   switch (operation)
   {
      case '!': break;
      case '^': ;
      case '*': ;
      case '-': ;
      case '+': ;
      case '\\': ;
      case '/': ;
      {
	 if(paramcount < (b+1))
	 {
	    printf("The operator %c requires a second operand.", operation);
	    return 0;
	 }
	 if(!allnums(operand2))
	 {
	    printf("'%s' is not a positive integer.\n",operand2);
	    return 0;
	 }
	 if(*operand2 == '-')
	 {
	    minus2 = TRUE;
	    operand2++;
	 }
	 break;
      }
      default :
      {
	 printf("Valid operations are +,-,*,/,^,\\ and !\n");
	 return 0;
      }
   }
   return 1;
}

int addcomma(char *s)
{
   char ta[MAXSIZE], *t;
   int psn, minloc = 3;

   t = ta;

   if(strlen(s) == 0) return 0;   /* something is wrong */

/*   psn = strlen(s);*/
   psn = strcspn(s, ".");
   if(*s == '-') minloc++;
   while((psn > minloc) && (strlen(s) < MAXSIZE))
   {
      psn = psn - 3;
      strcpy(t, (s+psn));
      *(s+psn) = ',';
      *(s+psn+1) = '\0';
      strcat(s, t);
   }
   return 1;
}

void rightpad0(char *s, int zeros)
{
   int i, len;
   if((strlen(s) + zeros) > MAXSIZE)
   {
      printf("MAXSIZE too small in rightpad0.\n");
      exit(0);
   }
   len = strlen(s);
   for(i=0; i<zeros; i++) *(s+len+i) = '0';
   *(s+len+zeros) = '\0';
}

int decimalcheck(void)
{
   /* Check for decimal points in operand1 and operand2. */

   int d1, d2, len1, len2, i;

   len1 = strlen(operand1);
   len2 = strlen(operand2);

   d1 = strcspn(operand1, ".");
   d2 = strcspn(operand2, ".");

   decimal1 = len1 - d1 - 1;
   decimal2 = len2 - d2 - 1;

   if(operation == '\\' && (decimal1>=0 || decimal2>=0)) return 0;
   if(operation == '^' && decimal2>=0) return 0;
   if(operation == '!' && decimal1>=0) return 0;


   /* now remove decimal point from operand1 and operand2
      and left shift the string (including the null character */

   for(i=0; i<=decimal1; i++)
      *(operand1+len1-decimal1+i-1) = *(operand1+len1-decimal1+i);
   for(i=0; i<=decimal2; i++)
      *(operand2+len2-decimal2+i-1) = *(operand2+len2-decimal2+i);

   if(decimal1 == -1) decimal1 = 0;
   if(decimal2 == -1) decimal2 = 0;

   return 1;
}

void adddecimal(char *s, long place)
{
   int i;
   long len;

   len = strlen(s);

   if(place > len)
   {
      leftpad0(s, place);
      len = place;
   }

   for(i=0; i<=place; i++)
      *(s+len-i+1) = *(s+len-i);
   *(s+len-place) = '.';
}




